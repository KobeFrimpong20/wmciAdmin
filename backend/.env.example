# SQLite database file path (optional, defaults to binder.db)
DB_PATH=binder.db

# Shared admin password used for POST /login (required)
ADMIN_PASSWORD=change-me-in-local-dev

# Secret key used to sign HS256 JWTs (required)
JWT_SECRET=replace-with-a-long-random-secret

# Optional JWT lifetime in hours (defaults to 24)
JWT_TTL_HOURS=24
